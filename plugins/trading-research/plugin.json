{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "trading-research",
  "version": "0.1.0",
  "description": "Explore the Gaps study, read recorded results and run its frozen research template locally.",
  "author": {"name": "fahedb"},
  "repository": "https://github.com/fahedb/trading-research-suite",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Trading Research",
        "shortDescription": "Your research, connected to Codex",
        "developerName": "fahedb",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "defaultPrompt": ["Show me the Gaps research and explain its recorded results."]
      }
    }
  }
}
